rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Master Administrator verification
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "amitdhakar218@gmail.com" ||
        request.auth.uid == "GDEA30X3AjXuAMShGpr8wAVUWsD3" ||
        request.auth.uid == "1nIwLbkuClStOyJmwnfw951EiMq2"
      );
    }

    // Helper: Enforce that private business fields are never stored in customer documents
    function hasNoPrivateFields(data) {
      return !('privateSourceCost' in data) &&
             !('sourceCost' in data) &&
             !('sourceProductUrl' in data) &&
             !('privateSourceUrl' in data) &&
             !('supplierReference' in data) &&
             !('supplierUrl' in data) &&
             !('supplierInfo' in data) &&
             !('meeshoCostPrice' in data) &&
             !('adminNotes' in data) &&
             !('profit' in data) &&
             !('margin' in data) &&
             !('estimatedProductProfit' in data) &&
             !('internalProfit' in data);
    }

    // 1. PUBLIC PRODUCT CATALOG
    // Accessible to all customers for browsing.
    // Writes (even by Admin) are strictly rejected if the document contains ANY private business field.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && hasNoPrivateFields(request.resource.data);
      allow delete: if isAdmin();
    }

    // 2. ADMIN-CONFIDENTIAL PRODUCT & ORDER DATA (SOURCE COSTS, SUPPLIER URLS, MARGINS)
    // STRICTLY PROTECTED: Customers have ZERO read or write access under any circumstances.
    match /admin_product_data/{productId} {
      allow read, write: if isAdmin();
    }

    match /admin_order_data/{orderId} {
      allow read, write: if isAdmin();
    }

    // 3. CUSTOMER ORDERS (CASH ON DELIVERY ONLY)
    // Both customer-created and admin-managed order documents must NEVER contain private business fields.
    match /orders/{orderId} {
      // Customer creation: Authenticated user creating their own order with valid customer-safe COD data
      // Admin creation: Must also be free of private business fields
      allow create: if hasNoPrivateFields(request.resource.data) && (
        isAdmin() || (
          request.auth != null &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.paymentMode == 'Cash on Delivery (COD)' &&
          request.resource.data.status == 'Order Placed' &&
          request.resource.data.courier == '' &&
          request.resource.data.awb == '' &&
          // Coin discount per order cannot exceed 50 coins (Section 18)
          (!('coinsDiscount' in request.resource.data) || request.resource.data.coinsDiscount <= 50)
        )
      );

      // Customer read: Authenticated owner or master admin
      allow read: if isAdmin() || (
        request.auth != null && resource.data.userId == request.auth.uid
      );

      // Updates: Both Admin status/tracking updates and Customer cancellation/return updates
      // MUST NEVER contain private business fields
      allow update: if hasNoPrivateFields(request.resource.data) && (
        isAdmin() || (
          request.auth != null &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status in ['Cancelled', 'Order Placed', 'Return Pickup Scheduled', 'Return Requested'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancellationReason', 'cancelReason', 'returnDetails', 'status', 'history', 'referralRewardStatus'])
        )
      );

      // Deletion: Admin only
      allow delete: if isAdmin();
    }

    // 4. USER PROFILES & AUTHORITATIVE COIN WALLET
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      
      // Creation: Authenticated user initializing their own profile (strictly max 10 signup bonus coins)
      allow create: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        (!('coins' in request.resource.data) || request.resource.data.coins <= 10) &&
        (!('walletCoins' in request.resource.data) || request.resource.data.walletCoins <= 10)
      );

      // Updates: Customers can update general profile info (name, phone, addresses, cart, wishlist)
      // Customers CANNOT modify referral attribution, referralLocked, rewardStatus, or bonus status.
      // Customers CANNOT arbitrarily increase their coin balance (only spend up to 50 coins deduction).
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'signupBonusGranted', 'signupBonusCoins', 'signupBonusGrantedAt', 'signupBonusTransactionId', 'signupBonusAt',
          'referralAttributionStatus', 'referralAttributedAt', 'referralCapturedAt', 'referralRewardStatus',
          'referralLocked', 'rewardTransactionId', 'rewardedAt', 'eligibilityAt', 'referrerUid',
          'firstOrderId', 'firstOrderDeliveredAt', 'returnInitiatedAt', 'cancelledAt', 'disqualificationReason',
          'referralRewardAmount', 'referralRewardCoins', 'referralStatus', 'referralLifecycleStatus'
        ])) &&
        // Customer cannot overwrite referredByUid or referredByCode if already set
        (!('referredByUid' in resource.data) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['referredByUid', 'referredByCode', 'referralLocked'])) &&
        // Coin balance security: Customers CANNOT increase their own coin balance.
        // Balance changes from customer can only be deductions (spending up to 50 coins at checkout).
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'walletCoins']) || (
          (!('coins' in request.resource.data) || (request.resource.data.coins <= resource.data.coins && resource.data.coins - request.resource.data.coins <= 50)) &&
          (!('walletCoins' in request.resource.data) || (request.resource.data.walletCoins <= resource.data.walletCoins && resource.data.walletCoins - request.resource.data.walletCoins <= 50))
        ))
      );

      allow delete: if isAdmin();

      // Coin Transactions Ledger (Strict, deterministic audit records)
      match /coin_transactions/{txId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        // Only Admin/Backend can credit REFERRAL_REWARD (+50), ORDER_REFUND, or ADMIN_ADJUSTMENT
        // Customer can only record their one-time signup_bonus (10 coins) or order spend (deduction <= 50)
        allow create: if isAdmin() || (
          request.auth != null && request.auth.uid == userId && (
            ((txId == 'signup_bonus' || txId == ('signupBonus_' + userId)) && request.resource.data.type == 'SIGNUP_BONUS' && request.resource.data.amount == 10) ||
            ((request.resource.data.type == 'ORDER_SPEND' || request.resource.data.type == 'ORDER_DISCOUNT') && request.resource.data.amount <= 0 && request.resource.data.amount >= -50)
          )
        );
        allow update, delete: if isAdmin();
      }

      // Explicit User Subcollections (Replacing broad wildcard to ensure sensitive subcollections are never overridden)
      match /orders/{orderId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow create, update: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow delete: if isAdmin();
      }

      match /notifications/{notifId} {
        allow read, update, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow create: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }

      match /addresses/{addressId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }

      match /cart/{cartItemId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }

      match /wishlist/{wishId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    // 5. AUTHORITATIVE REFERRAL TRACKING RECORDS (referrals/{referredUid})
    // Enforces deterministic, immutable referral attributions and lifecycle states
    match /referrals/{referredUid} {
      // Read: Admin or participants in the referral (referred customer or original referrer)
      allow read: if isAdmin() || (
        request.auth != null && (
          request.auth.uid == referredUid ||
          (resource != null && resource.data.referrerUid == request.auth.uid)
        )
      );

      // Creation: Authenticated referred user upon initial account creation
      // Strictly enforces pending reward status and blocks self-referral
      allow create: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == referredUid &&
        request.resource.data.referredUid == request.auth.uid &&
        request.resource.data.referrerUid != request.auth.uid &&
        request.resource.data.status in ['WAITING_FOR_FIRST_ORDER', 'FIRST_ORDER_PLACED'] &&
        request.resource.data.rewardStatus == 'PENDING' &&
        request.resource.data.rewardCoins == 50
      );

      // Updates: Customer can link their first qualifying order if not yet linked
      // They are STRICTLY FORBIDDEN from altering rewardStatus, rewardedAt, rewardTransactionId, referrerUid or referredUid, eligibilityAt, returnInitiatedAt, cancelledAt, or changing firstOrderId once set
      allow update: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == referredUid &&
        request.resource.data.referrerUid == resource.data.referrerUid &&
        request.resource.data.referredUid == resource.data.referredUid &&
        request.resource.data.rewardStatus == resource.data.rewardStatus &&
        // Customer cannot alter or replace firstOrderId once established
        (!('firstOrderId' in resource.data) || request.resource.data.firstOrderId == resource.data.firstOrderId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'rewardStatus', 'rewardedAt', 'rewardTransactionId', 'rewardCoins', 'referrerUid', 'referredUid',
          'eligibilityAt', 'returnInitiatedAt', 'cancelledAt', 'cancellationAt', 'disqualificationReason'
        ])
      );

      allow delete: if isAdmin();
    }

    // 6. PUBLIC REFERRAL CODES INDEX (Safe, O(1) code-to-uid resolution without exposing user profiles)
    match /referral_codes/{code} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.code == code &&
        request.resource.data.active == true
      );
      allow update, delete: if isAdmin();
    }

    // 5. LIVE SUPPORT CHAT & TICKETS
    match /support_chats/{chatId} {
      // Customer can only read their own chat messages; admin can read all
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.clientId == request.auth.uid
        )
      );
      // Customer can only send messages as themselves (cannot impersonate admin)
      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isAdmin == false
      );
      // Admin can edit their own messages (with edited metadata) or update seen receipt; customer cannot edit; nobody can delete
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt', 'seen', 'seenAt', 'status']);
      allow delete: if false;
    }
    
    match /support_tickets/{ticketId} {
      // Customer can only read and manage their own tickets
      allow read: if isAdmin() || (
        request.auth != null && resource.data.userId == request.auth.uid
      );
      allow create: if isAdmin() || (
        request.auth != null && request.resource.data.userId == request.auth.uid
      );
      allow update: if isAdmin() || (
        request.auth != null && resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 6. PRODUCT REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       hasNoPrivateFields(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // 7. ANALYTICS & VISIT TRACKING
    // Anonymous storefront visitors can only create visit logs matching the strict schema.
    // Arbitrary injection is prevented by validating keys and field types.
    match /analytics_visits/{visitId} {
      allow create: if request.resource.data.keys().hasOnly(['visitorId', 'userAgent', 'timestamp', 'page', 'userName']) &&
                       request.resource.data.visitorId is string &&
                       request.resource.data.visitorId.size() <= 64 &&
                       request.resource.data.timestamp is string &&
                       hasNoPrivateFields(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Business intelligence, revenues, margins, and visit aggregates are STRICTLY ADMIN-ONLY.
    // Customers have ZERO read or write access.
    match /analytics_summary/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
